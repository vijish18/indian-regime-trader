# Copy to .env and fill in real values. Never commit the real .env file.
# settings.yaml holds non-secret, versioned configuration; this file holds
# secrets and per-deployment values that must never enter version control.

# --- Environment ---
ENVIRONMENT=paper          # paper | live
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# --- Database (storage/) ---
DATABASE_URL=postgresql://user:password@localhost:5432/indian_regime_trader

# --- Broker credentials (broker/) ---
BROKER_PROVIDER=paper       # paper | <broker adapter name once implemented>
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_CLIENT_ID=
BROKER_STATIC_IP=

# --- Market data vendor (data/) ---
MARKET_DATA_VENDOR=
MARKET_DATA_API_KEY=

# --- Monitoring / alerts (monitoring/) ---
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
