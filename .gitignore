# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example
# Phase 23: the filled-in production environment file. The *.example
# template is tracked; the file with real values in it never is.
deploy/*.env
!deploy/*.env.example
*.pem
*.key
id_rsa*

# Phase 23: persisted runtime state and backups. Both contain positions,
# order history and the audit trail.
state/
backups/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Data artifacts (raw/normalized market data, model registry, caches)
data_cache/
data_runs/
model_registry/
*.sqlite
*.sqlite3
*.db

# Logs
*.log
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
