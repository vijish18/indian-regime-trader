[Unit]
Description=Trading bot: rebalance orders from the open until bot.trade_until_ist

[Service]
Type=oneshot
User=irt
WorkingDirectory=/home/irt/bot
EnvironmentFile=/home/irt/bot/deploy/app.env
Environment=IRT_DATA_ROOT=/home/irt/bot_data PYTHONUNBUFFERED=1
Nice=5
ExecStart=/home/irt/bot/.venv/bin/python -m app.bot trade
TimeoutStartSec=3h
