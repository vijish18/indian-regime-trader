[Unit]
Description=Trading bot: weekly corporate-actions refresh + symbol repair

[Service]
Type=oneshot
User=irt
WorkingDirectory=/home/irt/bot
EnvironmentFile=/home/irt/bot/deploy/app.env
Environment=IRT_DATA_ROOT=/home/irt/bot_data PYTHONUNBUFFERED=1
Nice=5
ExecStart=/home/irt/bot/.venv/bin/python scripts/daily_data_update.py --corporate-actions
TimeoutStartSec=60min
