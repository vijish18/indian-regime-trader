# Database container credentials.
#
#   cp deploy/db.env.example deploy/db.env
#   chmod 600 deploy/db.env
#
# Mounted ONLY into the `db` service, never into the application
# container. The application connects as the least-privilege role below
# and has no business holding the credential that owns the schema.
#
# Generate each password with something that is not your memory:
#   openssl rand -base64 32
#
# These names are not arbitrary. POSTGRES_* are read by the postgres
# image's own entrypoint; APP_DB_* are read by
# deploy/postgres-init/01-least-privilege.sql, which runs once on an
# empty data directory.
#
# Changing a password after first boot does NOT take effect by editing
# this file: the init hook only fires on initialisation. Change it with
# ALTER ROLE against the running database, then update this file to match.

# --- The owner ("superuser") -----------------------------------------------
# Used for migrations, by a human, deliberately. The application never
# connects as this.
POSTGRES_DB=indian_regime_trader
POSTGRES_USER=irt_owner
POSTGRES_PASSWORD=

# --- The application role --------------------------------------------------
# NOSUPERUSER NOCREATEDB NOCREATEROLE; SELECT/INSERT/UPDATE/DELETE on rows
# only, and deliberately no TRUNCATE. Keep APP_DB_PASSWORD identical to the
# password in DATABASE_URL in deploy/app.env.
APP_DB_USER=irt_app
APP_DB_PASSWORD=
