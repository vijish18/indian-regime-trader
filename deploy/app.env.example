# Application container secrets and per-deployment values.
#
#   cp deploy/app.env.example deploy/app.env
#   chmod 600 deploy/app.env
#
# .gitignore and .dockerignore both exclude deploy/*.env, so the filled
# file cannot reach version control or an image layer by accident. It is
# still a plaintext file on a host: see docs/DEPLOYMENT.md §3.2 for moving
# these into a secret manager, which is what a deployment holding real
# broker credentials should do.
#
# There are deliberately TWO env files. This one is mounted into the
# application container; deploy/db.env.example holds the database
# superuser credentials and is mounted only into the database container.
# Splitting them means a compromised application container cannot read
# the credential that can drop the schema -- which is the whole point of
# the least-privilege role in deploy/postgres-init/01-least-privilege.sql.

# --- Environment -----------------------------------------------------------
# Deploy-time intent. deploy/entrypoint.sh refuses to start if either of
# these says "live"; the authoritative setting is execution.mode in
# config/settings.yaml, which app/service.py checks. Do not set "live"
# here to go live -- that is not how live trading is authorized. See
# docs/PRE_LIVE_CHECKLIST.md.
ENVIRONMENT=paper
EXECUTION_MODE=paper
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# The APPLICATION role, not the owner: it can read and write rows, and
# cannot create, drop or alter a table. What stands between a SQL
# injection or a bad migration script and the loss of the order history
# this system reconciles against after a restart.
#
# The host is the compose service name. The database is not published to
# the host at all, so this URL is only resolvable from inside the stack.
# Keep the password here identical to APP_DB_PASSWORD in deploy/db.env.
DATABASE_URL=postgresql://irt_app:CHANGE_ME@db:5432/indian_regime_trader

# --- Broker credentials ----------------------------------------------------
# Leave these EMPTY unless and until live trading has been authorized
# through docs/PRE_LIVE_CHECKLIST.md. The paper broker
# (broker/adapters/paper_broker.py) is an in-process simulation: it makes
# no network call and needs no credential. Credentials present in a paper
# deployment are pure downside -- they can leak, and they cannot help.
BROKER_PROVIDER=paper
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_CLIENT_ID=
BROKER_STATIC_IP=

# --- Market data vendor ----------------------------------------------------
MARKET_DATA_VENDOR=
MARKET_DATA_API_KEY=

# --- Monitoring / alerts ---------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
